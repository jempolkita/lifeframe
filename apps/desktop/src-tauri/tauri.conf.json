{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lifeframe",
  "version": "0.1.0",
  "identifier": "com.lifeframe.desktop",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:4200",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/desktop/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Lifeframe",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
